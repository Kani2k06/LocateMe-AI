# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration (Leave empty to use automatic local repository/storage fallback)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_PHOTOS=photos
SUPABASE_BUCKET_VIDEOS=cctv-videos
SUPABASE_BUCKET_FRAMES=cctv-frames

# Recognition & Detection Parameters
DEFAULT_SIMILARITY_THRESHOLD=0.80
DEFAULT_ALERT_THRESHOLD=0.90
FRAME_SAMPLE_INTERVAL_SECONDS=1.0

# Local Storage Directory
STORAGE_DIR=./storage
